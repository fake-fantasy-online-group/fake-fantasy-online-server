{
  "name": "ffo-client-distribution",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true
  }
